# Same database as the scraper service
DATABASE_URL=postgresql://user:password@host:5432/scentsibility

# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# App URL (used in emails)
APP_URL=http://localhost:3000

# Password reset emails — same sender as the price alerts. Set one of:
#   Gmail: an address and a Google app password
GMAIL_USER=
GMAIL_APP_PASSWORD=
#   or Resend (needs a verified domain to email anyone but yourself)
RESEND_API_KEY=
EMAIL_FROM=

# Shown on the Privacy and Terms pages for data requests (optional)
CONTACT_EMAIL=
